---
const name = "VAIDEHI GOHIL";
const tagline = "Embedded • Hardware • Test & Validation";
const social = [
  { label: "GitHub", href: "https://github.com/v-dahi", icon: "github" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/vaidehigohil/", icon: "linkedin" },
  { label: "Resume", href: "/public/Resume_VaidehiG.pdf", icon: "file" },
];
// Projects: image LEFT, text RIGHT, button bottom-right
const projects = [
  {
    title: "Hip Exoskeleton — IMU Firmware & Bring-up",
    description: "A new open-source IMU driver for the moteus servo firmware so a hip exoskeleton could read its orientation sensor — written, tested, and debugged against live sensor data during hardware bring-up.",
    image: "/projects/exo_1.jpg",
    href: "/projects/hip-exo-imu-firmware",
  },
  {
    title: "Desk Robot — Totoro Companion",
    description: "A small desk robot I'm building from scratch to push myself from electronics into mechanical design — teaching myself Fusion 360 CAD to model and 3D-print the body.",
    image: "/projects/deskrobot_1.jpg",
    href: "/projects/desk-robot",
  },
  {
    title: "Telehealth: Connectivity to Wellness",
    description: "A portable telehealth kiosk that streams live patient vitals to remote specialists, so clinical decisions are backed by real data, not just a video call.",
    image: "/projects/telehealth_3.png",
    href: "/projects/telehealth",
  },
  {
    title: "Smart Street Light",
    description: "A solar-powered smart street light prototype that automatically adjusts brightness based on ambient conditions and vehicle presence.",
    image: "/projects/ssl1.webp",
    href: "/projects/smart-street-light",
  },
  {
    title: "Smart Water Distribution System",
    description: "An IoT-based prototype that monitors water flow in real time and lets you control distribution valves remotely through a mobile app.",
    image: "/projects/swds_1.jpg",
    href: "/projects/water-distribution-system",
  },
  {
    title: "FSAE: IIOT Based Digital Twin",
    description: "A field-level encryption framework for Industrial IoT Digital Twin systems that protects sensitive telemetry without breaking real-time performance.",
    image: "/projects/fsae_1.jpeg.webp",
    href: "/projects/fsae-iiot-digital-twin",
  },
];
const experience = [
  {
  role: "Graduate Research Assistant",
  org: "Shepherd Lab (Wearable Robotics), Northeastern University",
  dates: "Jun 2026 – Present",
  location: "Boston, MA",
  type: "Research",
  skills: ["Embedded Firmware", "IMU / MPU6050", "moteus", "Hardware Bring-up", "Battery Packs", "Open Source"],
  bullets: [
    "Wrote a new IMU driver for the open-source moteus servo firmware so a hip exoskeleton could read its MPU6050 IMU, which the existing firmware did not support; tested and debugged it against live sensor output and contributed it back as open source.",
    "Building custom battery packs for a back exoskeleton and integrating the same IMU firmware across the back and hip exos.",
  ],
},
  {
    role: "Graduate Research Assistant",
    org: "Mon(IoT)r Lab, Northeastern University",
    dates: "Mar 2026 – JUL 2026",
    location: "Boston, MA",
    type: "Volunteering",
    skills: ["IoT", "SPHERE Testbed", "Research"],
    bullets: [
      "Contributing to the SPHERE IoT project, an NSF-funded open testbed for cybersecurity and privacy research with 100+ IoT devices.",
      "Working on XY Plotter hardware integration as part of the lab's IoT device instrumentation efforts.",
    ],
  },
  {
    role: "IoT Engineer",
    org: "Faclon Labs",
    dates: "Nov 2024 – Aug 2025",
    location: "Mumbai, India",
    type: "Full-time",
    skills: ["Python", "Linux", "MQTT", "Modbus RTU/TCP", "I2C", "SPI", "UART", "RS-485", "BLE", "OpenWrt", "JSON"],
    bullets: [
      "Built a fault-tolerant telemetry service on OpenWrt with a Python Modbus poller, TCP services with timeout validation, retry/backoff logic, and watchdog auto-recovery and deployed across 5+ remote industrial sites with minimal manual intervention.",
      "Integrated heterogeneous devices over I2C, SPI, UART, RS-485, and BLE, defined register maps and polling schedules, and standardized all outputs into structured JSON published via MQTT and HTTP for consistent dashboards and faster field diagnostics.",
      "Validated in-house BMS PCB power-path switching across a three MOSFET stage, ensuring correct state transitions and basic functionality during system bring-up.",
    ],
  },
];
function iconSvg(name) {
  if (name === "github")
    return `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M12 .5C5.73.5.75 5.66.75 12.14c0 5.18 3.33 9.57 7.95 11.12.58.12.8-.26.8-.57v-2.1c-3.24.73-3.92-1.43-3.92-1.43-.53-1.4-1.28-1.78-1.28-1.78-1.05-.75.08-.74.08-.74 1.16.08 1.77 1.24 1.77 1.24 1.03 1.83 2.7 1.3 3.36.99.1-.77.4-1.3.73-1.6-2.59-.31-5.31-1.34-5.31-5.97 0-1.32.45-2.4 1.2-3.25-.12-.3-.52-1.55.12-3.23 0 0 .98-.33 3.2 1.24a10.7 10.7 0 0 1 5.82 0c2.22-1.57 3.2-1.24 3.2-1.24.64 1.68.24 2.93.12 3.23.75.85 1.2 1.93 1.2 3.25 0 4.64-2.73 5.66-5.33 5.97.41.38.78 1.12.78 2.27v3.36c0 .31.22.69.8.57 4.62-1.55 7.95-5.94 7.95-11.12C23.25 5.66 18.27.5 12 .5Z"/>
    </svg>`;
  if (name === "linkedin")
    return `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.95v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.66-1.85 3.41-1.85 3.65 0 4.33 2.4 4.33 5.51v6.23ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.8 0 0 .77 0 1.72v20.56C0 23.23.8 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z"/>
    </svg>`;
  return `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm0 2.5L19.5 10H14V4.5ZM8 13h8v2H8v-2Zm0 4h8v2H8v-2Zm0-8h5v2H8V9Z"/>
    </svg>`;
}
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{name} — Portfolio</title>
  <style>
    :root {
      --bg: #0b0f19;
      --card: rgba(255, 255, 255, 0.06);
      --card2: rgba(255, 255, 255, 0.08);
      --text: rgba(255, 255, 255, 0.92);
      --muted: rgba(255, 255, 255, 0.65);
      --line: rgba(255, 255, 255, 0.12);
      --chip: rgba(255, 255, 255, 0.10);
      --max: 1200px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      background: #000000;
      color: var(--text);
    }
    .gradient-bg {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(1200px 600px at 15% 80%, rgba(110,168,255,0.18), transparent 60%),
        radial-gradient(900px 500px at 85% 90%, rgba(180,110,255,0.14), transparent 55%),
        linear-gradient(180deg, transparent 0%, transparent 55%, #0b0f19 80%);
      pointer-events: none;
      z-index: 0;
    }
    .wrap { position: relative; z-index: 1; }
    a { color: var(--text); text-decoration: none; }
    a:hover { text-decoration: none; }
    .wrap { max-width: var(--max); margin: 0 auto; padding: 28px 18px 72px; }

    /* Icons pinned to top-right of the window */
    .social {
      position: fixed;
      top: 18px;
      right: 22px;
      display: flex;
      gap: 14px;
      z-index: 50;
    }
    .iconBtn {
      width: 28px;
      height: 28px;
      border-radius: 10px;
      background: transparent;
      display: grid;
      place-items: center;
    }
    .iconBtn svg { width: 15px; height: 15px; opacity: 0.9; }
    .iconBtn:hover { background: rgba(255,255,255,0.06); }
    .iconBtn:hover svg { opacity: 1; }

    /* Memoji float animation */
    @keyframes float {
      0%   { transform: translateY(0px); }
      50%  { transform: translateY(-10px); }
      100% { transform: translateY(0px); }
    }
    .memoji-wrap {
      display: flex;
      justify-content: center;
      margin-bottom: 10px;
    }
    .memoji {
      width: 320px;
      height: 320px;
      object-fit: cover;
      animation: float 3s ease-in-out infinite;
      transition: width 0.4s ease, height 0.4s ease;
    }
    .memoji.shrunk {
      width: 80px;
      height: 80px;
    }

    /* CENTERED header */
    .center {
      text-align: center;
      padding-top: 22px;
      margin-bottom: 10px;
    }
    .name {
      margin: 0;
      font-size: 52px;
      font-weight: 900;
      letter-spacing: -1.1px;
      line-height: 1.02;
    }
    .tagline { margin: 10px 0 0; color: var(--muted); font-size: 16px; }

    /* Toggle centered */
    .toggleWrap { display: flex; justify-content: center; margin-top: 18px; }
    .toggle { display: inline-flex; gap: 18px; align-items: center; }
    .toggle button {
      border: 0;
      background: transparent;
      color: rgba(255,255,255,0.75);
      padding: 8px 0;
      font-size: 14px;
      cursor: pointer;
      border-bottom: 2px solid transparent;
    }
    .toggle button[aria-pressed="true"] {
      color: var(--text);
      border-bottom-color: rgba(255,255,255,0.55);
    }
    .section { margin-top: 22px; }
    .hidden { display: none !important; }

    /* PROJECT GRID */
    .projGrid {
      display: grid;
      gap: 34px;
      margin-top: 22px;
    }
    .projCard {
      display: grid;
      grid-template-columns: 380px 1fr;
      gap: 34px;
      align-items: stretch;
      border: 1px solid var(--line);
      background: var(--card);
      border-radius: 22px;
      padding: 50px;
    }
    .thumb {
      width: 380px;
      height: 240px;
      object-fit: cover;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,0.10);
    }
    .projCard:hover {
      border-color: rgba(255,255,255,0.24);
    }
    .projText {
      min-width: 0;
      display: flex;
      flex-direction: column;
    }
    .projTitle {
      margin: 0;
      font-size: 30px;
      font-weight: 900;
      letter-spacing: -0.5px;
      line-height: 1.1;
    }
    .projDesc {
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 20px;
      font-style: italic;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .projAction {
      margin-top: auto;
      display: flex;
      justify-content: flex-end;
      padding-top: 75px;
    }
    .detailsBtn {
      border: 1px solid var(--line);
      background: var(--card2);
      padding: 14px 18px;
      border-radius: 16px;
      font-size: 15px;
      color: var(--text);
      text-decoration: none;
      white-space: nowrap;
    }
    .detailsBtn:hover {
      border-color: rgba(255,255,255,0.24);
    }

    /* Experience cards */
    .grid { display: grid; gap: 12px; margin-top: 12px; }
    #section-experience { min-height: 100vh; padding-bottom: 300px; }
    .card {
      border: 1px solid var(--line);
      background: var(--card);
      border-radius: 18px;
      padding: 16px;
    }
    .title { margin: 0; font-size: 16px; font-weight: 760; }
    .subtitle { margin: 6px 0 0; color: var(--muted); font-size: 13px; }
    ul { margin: 10px 0 0 18px; color: rgba(255,255,255,0.82); }
    li { margin: 6px 0; line-height: 1.45; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .chip {
      font-size: 12px;
      color: rgba(255,255,255,0.78);
      border: 1px solid var(--line);
      background: var(--chip);
      padding: 6px 10px;
      border-radius: 999px;
    }

    /* Mobile */
    @media (max-width: 720px) {
      .wrap { padding-top: 20px; }
      .social { position: static; justify-content: center; margin-bottom: 10px; }
      .center { padding-top: 6px; }
      .name { font-size: 40px; }
      .memoji { width: 90px; height: 90px; }
      .projGrid { gap: 22px; }
      .projCard { grid-template-columns: 1fr; padding: 20px; gap: 16px; }
      .thumb { width: 100%; height: 260px; }
      .projTitle { font-size: 22px; }
      .projDesc { font-size: 16px; }
      .projAction { justify-content: flex-start; padding-top: 16px; }
    }
  </style>
</head>
<body>
  <div class="gradient-bg"></div>
  <div class="wrap">
    <div class="social" aria-label="Links">
      {social.map((s) => (
        <a
          class="iconBtn"
          href={s.href}
          target={s.href.startsWith("http") ? "_blank" : undefined}
          aria-label={s.label}
          title={s.label}
          set:html={iconSvg(s.icon)}
        />
      ))}
    </div>

    <header>
      <div class="center">
        <div class="memoji-wrap">
          <video
            id="memoji"
            class="memoji"
            autoplay
            loop
            muted
            playsinline
            disablepictureinpicture
            preload="auto"
            style="pointer-events: none;"
          >
            <source src="/memoji.mp4" type="video/mp4" />
            <source src="/memoji.mov" type="video/quicktime" />
          </video>
        </div>
        <h1 class="name">{name}</h1>
        <p class="tagline">{tagline}</p>
      </div>
      <div class="toggleWrap">
        <div class="toggle" role="group" aria-label="Toggle section">
          <button id="btn-projects" aria-pressed="true" type="button">Projects</button>
          <button id="btn-experience" aria-pressed="false" type="button">Experience</button>
        </div>
      </div>
    </header>

    <!-- Projects (default visible) -->
    <section id="section-projects" class="section">
      <div class="projGrid">
        {projects.map((p) => (
          <div class="projCard">
            <img class="thumb" src={p.image} alt={`${p.title} thumbnail`} loading="lazy" />
            <div class="projText">
              <p class="projTitle">{p.title}</p>
              <p class="projDesc">{p.description}</p>
              <div class="projAction">
                <a class="detailsBtn" href={p.href} aria-label={`Open details for ${p.title}`}>
                  Project details
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience (hidden until toggled) -->
    <section id="section-experience" class="section hidden">
      <div class="grid">
        {experience.map((e) => (
          <article class="card">
            <p class="title">{e.role} — {e.org}</p>
            <p class="subtitle">{e.location} • {e.dates} • <span style="opacity:0.7; font-style:italic;">{e.type}</span></p>
            <div class="chips">
              {e.skills.map((s) => <span class="chip">{s}</span>)}
            </div>
            <ul>
              {e.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script>
    // Force memoji video autoplay
    const memojiEl = document.getElementById("memoji");
    memojiEl.muted = true;
    memojiEl.play().catch(() => {
      document.addEventListener("click", () => memojiEl.play(), { once: true });
    });

    // Memoji shrink on scroll
    const memoji = document.getElementById("memoji");
    function checkScroll() {
      if (window.scrollY > 60) {
        memoji.classList.add("shrunk");
      } else {
        memoji.classList.remove("shrunk");
      }
    }
    window.addEventListener("scroll", checkScroll);

    const btnProjects = document.getElementById("btn-projects");
    const btnExperience = document.getElementById("btn-experience");
    const sectionProjects = document.getElementById("section-projects");
    const sectionExperience = document.getElementById("section-experience");

    function show(which) {
      const projectsOn = which === "projects";
      sectionProjects.classList.toggle("hidden", !projectsOn);
      sectionExperience.classList.toggle("hidden", projectsOn);
      btnProjects.setAttribute("aria-pressed", projectsOn ? "true" : "false");
      btnExperience.setAttribute("aria-pressed", projectsOn ? "false" : "true");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    btnProjects.addEventListener("click", () => show("projects"));
    btnExperience.addEventListener("click", () => show("experience"));
  </script>
</body>
</html>