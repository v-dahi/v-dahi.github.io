---
import { getCollection } from "astro:content";
import PhotoSlider from "../../components/PhotoSlider.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const d = project.data;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{d.title} — Project</title>

    <style>
      :root{
        --bg:#0b0f19;
        --card:rgba(255,255,255,0.06);
        --card2:rgba(255,255,255,0.08);
        --text:rgba(255,255,255,0.92);
        --muted:rgba(255,255,255,0.65);
        --line:rgba(255,255,255,0.12);
        --chip:rgba(255,255,255,0.10);
        --max: 1100px;
      }
      *{box-sizing:border-box}
      body{
        margin:0;
        font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;
        background: radial-gradient(1200px 600px at 15% 10%, rgba(110,168,255,0.25), transparent 60%),
                    radial-gradient(900px 500px at 85% 30%, rgba(180,110,255,0.18), transparent 55%),
                    var(--bg);
        color:var(--text);
      }
      a{color:var(--text); text-decoration:none}
      a:hover{text-decoration:none}

      .wrap{max-width:var(--max); margin:0 auto; padding:34px 18px 72px}
      .topbar{display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:18px}
      .back{border:1px solid var(--line); background:var(--card2); padding:10px 12px; border-radius:14px; font-size:14px}
      .pillrow{display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end}
      .pill{border:1px solid var(--line); background:var(--card2); padding:10px 12px; border-radius:14px; font-size:14px}

      .hero{
        display:grid;
        grid-template-columns: 420px 1fr;
        gap: 22px;
        align-items: stretch;
      }
      .panel{border:1px solid var(--line); background:var(--card); border-radius:22px; padding:22px}
      .title{margin:0; font-size:36px; font-weight:950; letter-spacing:-0.7px; line-height:1.05}
      .one{margin:12px 0 0; color:var(--muted); font-size:18px; font-style:italic; line-height:1.45}

      .img{
        width:100%;
        height: 280px;
        object-fit: cover;
        border-radius: 18px;
        border:1px solid rgba(255,255,255,0.10);
      }

      .chips{display:flex; flex-wrap:wrap; gap:10px; margin-top:16px}
      .chip{border:1px solid var(--line); background:var(--chip); padding:8px 12px; border-radius:999px; font-size:13px; color:rgba(255,255,255,0.78)}

      .meta{margin-top:12px; color:var(--muted); font-size:13px}
      .list{margin:12px 0 0 18px; color:rgba(255,255,255,0.84); line-height:1.6}
      .list li{margin:6px 0}

      .content{margin-top:18px}
      .content .panel{padding:26px}
      .content :global(h2){margin:0 0 12px; font-size:18px}
      .content :global(p){margin:0 0 12px; color:rgba(255,255,255,0.84); line-height:1.7}
      .content :global(ul){margin:0 0 12px 18px; color:rgba(255,255,255,0.84); line-height:1.7}
      .content :global(code){background:rgba(255,255,255,0.08); padding:2px 6px; border-radius:8px}

      @media (max-width: 820px){
        .hero{grid-template-columns: 1fr}
        .title{font-size:28px}
        .one{font-size:16px}
        .img{height:260px}
      }
    </style>
  </head>

  <body>
    <div class="wrap">
      <div class="topbar">
        <a class="back" href="/">← Back</a>

        <div class="pillrow">
          {d.repo && <a class="pill" href={d.repo} target="_blank">Repo</a>}
          {d.demo && <a class="pill" href={d.demo} target="_blank">Demo</a>}
          {d.paper && <a class="pill" href={d.paper} target="_blank">Paper</a>}
          {d.patent && <a class="pill" href={d.patent} target="_blank">Patent</a>}
        </div>
      </div>

      <section class="hero">
        <div class="panel">
          {d.image && <img class="img" src={d.image} alt={`${d.title} image`} loading="lazy" />}
          {d.date && <div class="meta">{d.date}</div>}
          {d.skills?.length > 0 && (
            <div class="chips">
              {d.skills.map((s) => <span class="chip">{s}</span>)}
            </div>
          )}
        </div>

        <div class="panel">
          <h1 class="title">{d.title}</h1>
          <p class="one">{d.oneLiner}</p>

          {d.highlights?.length > 0 && (
            <>
              <div class="meta" style="margin-top:16px;"><strong>Highlights</strong></div>
              <ul class="list">
                {d.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </>
          )}

          {d.awards?.length > 0 && (
            <div class="meta" style="margin-top:14px;">
              <strong>Awards:</strong> {d.awards.join(" • ")}
            </div>
          )}
        </div>
      </section>

      <section class="content">
        {d.photos?.length > 0 && (
          <div class="panel" style="margin-bottom:18px;">
            <div class="meta" style="margin-bottom:10px;"><strong>Photos</strong></div>
            <PhotoSlider images={d.photos} altPrefix={d.title} />
         </div>
        )}

        <div class="panel">
          <Content />
        </div>
      </section>
    </div>
  </body>
</html>
